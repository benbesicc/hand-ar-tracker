#  pyenv
#    for a library or package you might want to ignore these files since the values are
#    specific to the developers system but for a desktopweb application you might
#    want to check them in
#  python-version

#  pipenv
#    according to pypapipenv598 it is recommended to include pipfilelock in version control
#    however in case of collaboration if delegates have different platforms it could be harmful
#  pipfilelock

#  poetry
#    similar to pipfilelock poetrylock contains system-specific information and should be ignored
#    if not desired
#  poetrylock

#  pdm
#    similar to pipfilelock pdmlock contains system-specific information and should be ignored
#    if not desired
#  pdmlock

#  pep 582 project local packages directory (used by pdm)
